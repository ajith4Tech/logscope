# Local override (copy from config.example.yaml). May contain cluster names and S3 identifiers.
config.yaml

# Filled S3 credentials — copy from deploy/k3s/s3-secret.example.yaml
deploy/k3s/s3-secret.yaml

# Operator Helm values for the web app (cluster-specific)
deploy/helm/logscope/values.local.yaml

# Scratch data from local container smoke tests
.audit-tmp/

# Runtime data — never commit scraped logs or offsets
logs/
backups/
.state/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editor / OS
.DS_Store
*.swp

# Build outputs (make bin / make sbom) and the generated version module
dist/
build/
logscope/_version.py

# Rendered by `logscope render` from config.yaml — real cluster/S3 config, never commit
deploy/vector.yaml
deploy/values-*.yaml
deploy/namespace.yaml
deploy/backup-cronjob.yaml
